{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rongyok Downloader HUD",
  "version": "2.0.0",
  "identifier": "com.rongyok.downloader.hud",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rongyok Video Downloader HUD",
        "width": 1050,
        "height": 780,
        "minWidth": 800,
        "minHeight": 650,
        "resizable": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
